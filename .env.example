# Sao chép thành .env rồi điền giá trị. KHÔNG đưa file .env lên GitHub.
DB_PASSWORD=          # openssl rand -hex 24
APP_SECRET=           # openssl rand -hex 32
DATA_KEY=             # openssl rand -hex 32  (mất khóa này = mất mã 2FA đã lưu; hãy cất bản sao ở nơi an toàn)
BACKUP_PASSPHRASE=    # openssl rand -hex 32  (mất = không giải mã được bản sao lưu; CẤT BẢN SAO NGOÀI MÁY!)
CLOUDFLARE_TUNNEL_TOKEN=
RCLONE_REMOTE=gdrive:KPV-EMR-Backup
HEALTHCHECK_BACKUP_URL=   # URL ping từ healthchecks.io (báo email khi sao lưu không chạy/thất bại)
ALERT_WEBHOOK_URL=        # webhook báo lỗi (Zalo/Telegram/Slack nếu có)
