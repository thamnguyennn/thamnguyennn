generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALE
  RECEPTION
  DOCTOR
  THERAPIST
  MANAGER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  VISITED
  LOST
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

enum EncounterStatus {
  WAITING       // chờ khám
  IN_EXAM       // đang khám
  IN_TREATMENT  // đang điều trị / trị liệu
  CHECKOUT      // chờ thu ngân
  DONE
  CANCELLED
}

// ───────── Người dùng & bảo mật ─────────
model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  fullName           String
  role               Role
  phone              String?
  email              String?
  title              String?   // học hàm/chức danh in trên phiếu (BS, CN, KTV...)
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  totpSecretEnc      String?   // mã hóa AES-256-GCM
  totpEnabled        Boolean   @default(false)
  active             Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions AuthSession[]
}

model AuthSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  userId   String?
  username String?
  action   String   // LOGIN, LOGIN_FAILED, VIEW, CREATE, UPDATE, ...
  entity   String?
  entityId String?
  ip       String?
  meta     Json?

  @@index([at])
  @@index([userId, at])
  @@index([entity, entityId])
}

// ───────── Lead / lịch hẹn ─────────
model LeadSource {
  id     String  @id @default(uuid())
  name   String  @unique
  active Boolean @default(true)
  leads  Lead[]
}

model Lead {
  id         String     @id @default(uuid())
  fullName   String
  phone      String
  sourceId   String?
  saleId     String?    // người sale phụ trách
  status     LeadStatus @default(NEW)
  note       String?
  patientId  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  source       LeadSource?   @relation(fields: [sourceId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id])
  appointments Appointment[]

  @@index([phone])
}

// ───────── Bệnh nhân ─────────
model Patient {
  id         String    @id @default(uuid())
  code       String    @unique // KPV-26-000001
  fullName   String
  birthYear  Int
  gender     Gender
  phone      String
  address    String?
  occupation String?
  note       String?
  createdAt  DateTime  @default(now())
  createdById String?
  updatedAt  DateTime  @updatedAt

  consents     PatientConsent[]
  leads        Lead[]
  appointments Appointment[]
  encounters   Encounter[]
  exams        ExamForm[]
  plans        TreatmentPlan[]

  @@index([phone])
  @@index([fullName])
}

model PatientConsent {
  id          String   @id @default(uuid())
  patientId   String
  version     String   // phiên bản văn bản đồng ý
  purpose     String   // "xử lý dữ liệu cá nhân & dữ liệu sức khỏe"
  givenAt     DateTime @default(now())
  recordedById String?
  method      String   @default("PAPER") // PAPER | SCREEN
  revokedAt   DateTime?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

model Appointment {
  id          String            @id @default(uuid())
  leadId      String?
  patientId   String?
  fullName    String            // snapshot tên/SĐT lúc đặt
  phone       String
  startAt     DateTime
  durationMin Int               @default(60)
  doctorId    String?
  therapistId String?
  saleId      String?
  status      AppointmentStatus @default(BOOKED)
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lead       Lead?       @relation(fields: [leadId], references: [id])
  patient    Patient?    @relation(fields: [patientId], references: [id])
  encounters Encounter[]

  @@index([startAt])
  @@index([doctorId, startAt])
}

// Mỗi lượt đến phòng khám
model Encounter {
  id            String          @id @default(uuid())
  patientId     String
  appointmentId String?
  visitNo       Int             // lần khám thứ mấy (tự đếm)
  visitDate     DateTime        @default(now())
  queueNo       Int             // số thứ tự trong ngày
  doctorId      String?
  therapistId   String?
  status        EncounterStatus @default(WAITING)
  checkedInById String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  exam        ExamForm?
  sessions    TreatmentSession[]

  @@index([visitDate])
  @@index([patientId])
}

// Bộ đếm để sinh mã hồ sơ / số thứ tự không trùng
model Counter {
  key   String @id // vd: "patient:2026", "queue:2026-11-19"
  value Int    @default(0)
}

// ───────── Danh mục dịch vụ / bảng giá ─────────
model Service {
  id          String  @id @default(uuid())
  code        String  @unique  // CC, DX, SA, XK, TT, HN, NE, PF, TLMM, DDK, COMBO_CB...
  name        String
  kind        String  // COMBO | SINGLE
  price       Int     // VNĐ / buổi
  durationMin Int
  durationMax Int?
  unitNote    String? // "01 vùng", "2000 xung/01 vùng"...
  description String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

// Danh mục ICD-10 (nhập từ danh mục chính thức của Bộ Y tế)
model Icd10 {
  code String @id
  name String

  @@index([name])
}

// ───────── Phiếu khám ─────────
enum ExamStatus {
  DRAFT
  SIGNED
}

model ExamForm {
  id          String     @id @default(uuid())
  encounterId String     @unique
  patientId   String
  data        Json       // nội dung phiếu theo từng mục I–XII
  status      ExamStatus @default(DRAFT)
  rev         Int        @default(1) // chống ghi đè khi 2 người cùng mở
  screening   String?    // ACCEPT | CAUTION | DEFER (tách riêng để hiện cảnh báo ở hàng đợi)
  createdById String?
  updatedById String?
  signedById  String?
  signedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  encounter  Encounter       @relation(fields: [encounterId], references: [id])
  patient    Patient         @relation(fields: [patientId], references: [id])
  amendments ExamAmendment[]

  @@index([patientId])
}

// Phiếu đã ký không sửa đè: mọi chỉnh sửa là một bản điều chỉnh có lý do
model ExamAmendment {
  id         String   @id @default(uuid())
  examFormId String
  version    Int
  reason     String
  data       Json     // toàn bộ nội dung sau điều chỉnh
  byId       String
  at         DateTime @default(now())

  exam ExamForm @relation(fields: [examFormId], references: [id])

  @@unique([examFormId, version])
}

// ───────── Liệu trình & phiếu theo dõi điều trị ─────────
enum PlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model TreatmentPlan {
  id            String     @id @default(uuid())
  patientId     String
  encounterId   String?    // lượt khám bác sĩ ra chỉ định
  examFormId    String?
  doctorId      String
  therapistId   String?    // trị liệu viên phụ trách mặc định
  totalSessions Int
  frequency     String?    // "3 buổi/tuần"
  reevalAfter   Int?       // tái lượng giá sau N buổi
  diagnosis     String?    // chụp lại chẩn đoán in trên phiếu theo dõi
  note          String?
  status        PlanStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patient  Patient            @relation(fields: [patientId], references: [id])
  items    PlanItem[]
  sessions TreatmentSession[]

  @@index([patientId, status])
}

// Thủ thuật được chỉ định trong liệu trình
model PlanItem {
  id          String @id @default(uuid())
  planId      String
  serviceCode String
  region      String? // vùng/huyệt vị điều trị
  note        String?

  plan TreatmentPlan @relation(fields: [planId], references: [id])

  @@index([planId])
}

// Một buổi điều trị = một dòng trong phiếu theo dõi
model TreatmentSession {
  id            String   @id @default(uuid())
  planId        String
  encounterId   String?
  sessionNo     Int
  date          DateTime @default(now())
  progress      String?  // diễn tiến
  note          String?  // ghi chú (phản ứng, lưu ý)
  adverse       Boolean  @default(false) // có phản ứng bất thường
  performedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan      TreatmentPlan   @relation(fields: [planId], references: [id])
  encounter Encounter?      @relation(fields: [encounterId], references: [id])
  lines     TreatmentLine[]

  @@unique([planId, sessionNo])
}

// Mỗi phương pháp thực hiện trong buổi: PP | TG | thông số/vùng
model TreatmentLine {
  id          String @id @default(uuid())
  sessionId   String
  serviceCode String
  minutes     Int?
  detail      String? // thông số máy / vùng
  sort        Int     @default(0)

  session TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
